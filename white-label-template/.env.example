# ── Per-client environment ─────────────────────────────────────────
# Copy to .env.local per client. All values are PUBLIC (client-side)
# because this is a static export — never put secrets here.
# Secrets (Resend API key, Twilio, etc.) live in the Cloudflare
# Worker that receives the form POST, not in this repo.

# Form endpoint the contact form POSTs to.
#   Formspree:          https://formspree.io/f/XXXXXXXX
#   Cloudflare Worker:  https://forms.<client>.workers.dev/submit
NEXT_PUBLIC_FORM_ENDPOINT=

# Optional. Fires in parallel with the form submit — point this at the
# Speed-to-Lead intake webhook for clients on the automation add-on.
NEXT_PUBLIC_LEAD_WEBHOOK_URL=

# Optional. Plausible domain (e.g. stanstire.com). Leave empty to
# disable analytics entirely. Script only loads after cookie consent.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
